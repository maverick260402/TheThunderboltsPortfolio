# Google Sheets Integration Environment Variables
# Copy this file to .env for local development

# Service Account Email (from Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Private Key (from service account JSON file - include the full key with newlines)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Sheet ID (from the spreadsheet URL)
# Example URL: https://docs.google.com/spreadsheets/d/1AbC123XyZ-456/edit
# Sheet ID: 1AbC123XyZ-456
GOOGLE_SHEET_ID=your-sheet-id-here

# IMPORTANT: Never commit the actual .env file to git!
# This is just a template. The actual credentials should be:
# - Stored in .env for local development (ignored by git)
# - Added as environment variables in Vercel Dashboard for production
